# Commit only sanitized *.example files.
*.jks
*.keystore
*.p12
*.pem
*.key
*.cer
*.crt
signing.properties
local.signing.properties

# Logs and temporary files
*.log
tmp/
.DS_Store
Thumbs.db
Desktop.ini
